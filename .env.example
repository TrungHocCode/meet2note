# meet2note dùng Ollama local mặc định (không dùng OpenAI).
# Copy file này thành .env rồi điền giá trị — KHÔNG commit .env thật.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Tuỳ chọn
# LLM_API_KEY=              # chỉ cần cho hosted endpoint, Ollama local bỏ qua
# LLM_TIMEOUT=300           # giây/call — model local nên đặt 300+
# LLM_JSON_MODE=1           # ép response_format json_object (model nhỏ không theo shape)
# LLM_STRUCTURED=1          # ép response_format json_schema từ Pydantic Literals
#                           # (constrained decoding; provider không hỗ trợ → tự fallback plain)
# LLM_NUM_CTX=8192          # passthrough options.num_ctx cho Ollama (default 4096 tràn prompt dài)
# LLM_TEMPERATURE=0

# Tương thích ngược (vẫn dùng được, ưu tiên tên LLM_* ở trên):
# OPENAI_BASE_URL=
# MODEL_NAME=
# OPENAI_API_KEY=
# API_KEY=

# P6 — Postgres + JWT auth:
# DATABASE_URL=postgresql+psycopg://meet2note:meet2note@localhost:5434/meet2note
# JWT_SECRET=   # P6b: chuỗi ngẫu nhiên dài (openssl rand -hex 32), KHÔNG commit giá trị thật

# Link demo (FE Vercel + BE tunnel tren may ban):
# CORS_ORIGINS=https://meet2note.vercel.app
# COOKIE_CROSS_SITE=1   # cookie qua site khac: SameSite=None + Secure (link HTTPS)
