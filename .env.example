# OpenAI-compatible endpoint (hosted) hoặc Ollama local
# Copy file này thành .env rồi điền giá trị — KHÔNG commit .env thật.
OPENAI_BASE_URL=
MODEL_NAME=

# Tuỳ chọn
# LLM_TEMPERATURE=0
# LLM_TIMEOUT=60          # giây/call — model local (Ollama) nên đặt 300+
# Ví dụ Ollama local:
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen3:8b
# LLM_TIMEOUT=300